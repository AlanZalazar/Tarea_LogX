registrar historial:
CREATE PROCEDURE RegistrarHistorial  
    @Paciente_ID INT,  
    @Fecha DATE,  
    @Diagnostico VARCHAR(255),  
    @Tratamiento VARCHAR(255),  
    @Observaciones TEXT  
AS  
BEGIN  
    INSERT INTO HistoriaClinica (Paciente_ID, Fecha, Diagnostico, Tratamiento, Observaciones)  
    VALUES (@Paciente_ID, @Fecha, @Diagnostico, @Tratamiento, @Observaciones);  
END;

ejemplo:
EXEC RegistrarHistorial  
    @Paciente_ID = 12345678,  
    @Fecha = '2024-03-25',  
    @Diagnostico = 'Hipertensión detectada',  
    @Tratamiento = 'Dieta baja en sodio y control periódico',  
    @Observaciones = 'Paciente debe volver en 2 meses para control';

consultar historial de paciente:
CREATE PROCEDURE ConsultarHistorialPaciente  
    @Paciente_ID INT  
AS  
BEGIN  
    SELECT * FROM HistoriaClinica  
    WHERE Paciente_ID = @Paciente_ID  
    ORDER BY Fecha DESC;  
END;

ejemplo:
EXEC ConsultarHistorialPaciente @Paciente_ID = 12345678;


registrar un pago:
CREATE PROCEDURE RegistrarPago    
    @Paciente_ID INT,  
    @Turno_ID INT,  
    @Fecha DATE,  
    @Monto DECIMAL(10,2)  
AS  
BEGIN  
    INSERT INTO Pagos (Paciente_ID, Turno_ID, Fecha, Monto)  
    VALUES (@Paciente_ID, @Turno_ID, @Fecha, @Monto);  
END;

ejemplo:
EXEC RegistrarPago    
    @Paciente_ID = 12345678,  
    @Turno_ID = 1,  
    @Fecha = '2024-03-25',  
    @Monto = 5000.00;


actualizar datos de paciente:
CREATE PROCEDURE ActualizarPaciente  
    @DNI INT,  
    @Nombre VARCHAR(50),  
    @Apellido VARCHAR(50),  
    @Direccion VARCHAR(100),  
    @FechaNacimiento DATE,  
    @Telefono VARCHAR(20),  
    @Email VARCHAR(50)  
AS  
BEGIN  
    UPDATE Paciente  
    SET Nombre = @Nombre,  
        Apellido = @Apellido,  
        Direccion = @Direccion,  
        FechaNcimiento = @FechaNacimiento,  
        Telefono = @Telefono,  
        Email = @Email  
    WHERE DNI = @DNI;  
END;

ejemplo:
EXEC ActualizarPaciente  
    @DNI = 12345678,  
    @Nombre = 'Juan Carlos',  
    @Apellido = 'Pérez',  
    @Direccion = 'Av. Siempreviva 742',  
    @FechaNacimiento = '1990-05-15',  
    @Telefono = '1133445566',  
    @Email = 'juan.carlos@email.com';


actualizar datos de medico:
CREATE PROCEDURE ActualizarMedico  
    @DNI INT,  
    @Nombre VARCHAR(50),  
    @Apellido VARCHAR(50),  
    @Especialidad VARCHAR(50),  
    @Telefono VARCHAR(20),  
    @Email VARCHAR(50)  
AS  
BEGIN  
    UPDATE Medico  
    SET Nombre = @Nombre,  
        Apellido = @Apellido,  
        Especialidad = @Especialidad,  
        Telefono = @Telefono,  
