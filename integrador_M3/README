1)Crear Base de datos:

CREATE DATABASE ClinicaMedica;
GO

USE ClinicaMedica;
GO


2)Crear las tablas:

CREATE TABLE Paciente (
    DNI INT PRIMARY KEY,
    Nombre VARCHAR(50),
    Apellido VARCHAR(50),
    Direccion VARCHAR(100),
    FechaNacimiento DATE,
    Telefono VARCHAR(20),
    Email VARCHAR(50)
);

CREATE TABLE Medico (
    DNI INT PRIMARY KEY,
    Nombre VARCHAR(50),
    Apellido VARCHAR(50),
    Especialidad VARCHAR(50),
    Telefono VARCHAR(20),
    Email VARCHAR(50)
);

CREATE TABLE HistoriaClinica (
    ID_Historia INT PRIMARY KEY IDENTITY(1,1),
    Paciente_ID INT,
    Fecha DATE,
    Diagnostico TEXT,
    Tratamiento TEXT,
    Observaciones TEXT
);

CREATE TABLE Turno (
    ID_Turno INT PRIMARY KEY IDENTITY(1,1),
    Paciente_ID INT,
    Medico_ID INT,
    Fecha DATE,
    Hora TIME,
    Estado VARCHAR(20),
    Motivo TEXT
);

CREATE TABLE Pagos (
    ID_Pago INT PRIMARY KEY IDENTITY(1,1),
    Paciente_ID INT,
    Turno_ID INT,
    Fecha DATE,
    Hora TIME,
    Estado VARCHAR(20),
    Monto DECIMAL(10,2)
);


3)Relacionamos las tablas:

-- Relaciones de claves foráneas (FK)
ALTER TABLE HistoriaClinica  
ADD CONSTRAINT FK_Historia_Paciente  
FOREIGN KEY (Paciente_ID) REFERENCES Paciente(DNI);

ALTER TABLE Turno  
ADD CONSTRAINT FK_Turno_Paciente  
FOREIGN KEY (Paciente_ID) REFERENCES Paciente(DNI);

ALTER TABLE Turno  
ADD CONSTRAINT FK_Turno_Medico  
FOREIGN KEY (Medico_ID) REFERENCES Medico(DNI);

ALTER TABLE Pagos  
ADD CONSTRAINT FK_Pagos_Paciente  
FOREIGN KEY (Paciente_ID) REFERENCES Paciente(DNI);

ALTER TABLE Pagos  
ADD CONSTRAINT FK_Pagos_Turno  
FOREIGN KEY (Turno_ID) REFERENCES Turno(ID_Turno);


4)Creamos los procedimientos:

insertar nuevos pacientes:
CREATE PROCEDURE InsertarPaciente  
    @DNI INT,  
    @Nombre VARCHAR(50),  
    @Apellido VARCHAR(50),  
    @Direccion VARCHAR(100),  
    @FechaNacimiento DATE,  
    @Telefono VARCHAR(20),  
    @Email VARCHAR(50)  
AS  
BEGIN  
    INSERT INTO Paciente (DNI, Nombre, Apellido, Direccion, FechaNacimiento, Telefono, Email)  
    VALUES (@DNI, @Nombre, @Apellido, @Direccion, @FechaNacimiento, @Telefono, @Email);  
END;

ejemplo:
EXEC InsertarPaciente  
    @DNI = 12345678,  
    @Nombre = 'Juan',  
    @Apellido = 'Pérez',  
    @Direccion = 'Calle Falsa 123',  
    @FechaNacimiento = '1990-05-15',  
    @Telefono = '1122334455',  
    @Email = 'juan.perez@email.com';


insertar nuevos medicos:
CREATE PROCEDURE InsertarMedico  
    @DNI INT,  
    @Nombre VARCHAR(50),  
    @Apellido VARCHAR(50),  
